#!/bin/bash

# Script to list, merge and delete .sync-conflict- files

# ---Helpers--------------------------------------
confirm() {
    local message="$1"
    local defaultChoice="$2"  # y/n
    [[ $defaultChoice == "y" ]] && choices="[Y/n]" || choices="[y/N]"

    while true; do
        read -rp "$message $choices " ans
        case $ans in
            y|Y)
                return 0 ;;
            n|N)
                return 1 ;;
            "")
                [[ $defaultChoice == "y" ]] && return 0 || return 1 ;;
        esac
    done
}
# ------------------------------------------------

# List conflicted files
if [[ $# -eq 0 || $1 == "list" || $1 == "l" ]];then
	find . -name "*.sync-conflict-*"

# Merge conflicted files
elif [[ $1 == "merge" || $1 == "resolve" || $1 == "m" || $1 == "r" ]];then
    conflictFile=$(find . -name "*.sync-conflict-*" -print -quit)
    if [[ ! -f $conflictFile ]];then
        echo "There a no conflicted files"
        exit 0
    fi

    currentFile=${conflictFile/.sync-conflict-*./.}
    if [[ ! -f $currentFile ]];then
        echo "There is no file to merge $conflictFile against"
        if confirm "Remove conflict tag?" "y";then
            mv "$conflictFile" "$currentFile"
        fi
        exit 0
    fi

    nvim -d "$currentFile" "$conflictFile"
    confirm "Delete conflicted file?" "y" || exit 0
    rm "$conflictFile"
    $0 merge 

# Delete all conflicted files
elif [[ $1 == "delete" || $1 == "d" ]];then
    confirm "Are you sure you want to delete all conflicted files?" "n" || exit 0
	find . -name "*.sync-conflict-*" -print -delete

# Help message
else
    echo "Script to list, merge and delete .sync-conflict- files

    $0 [list/merge/resolve/delete]

    list l
        Lists conflicted files

    merge/resolve m/r
        Merges conflicted files with their current state using Neovim

    delete d
        Deletes alls conflicted files"
fi
